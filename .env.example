BIND_ADDRESS=127.0.0.1
HOST_PORT=8787
IMPORTS_HOST_PATH=./imports
RUNTIME_HOST_PATH=./runtime

APP_TITLE="Personal WiGLE Map"
APP_EYEBROW="Wireless survey archive"
APP_VERSION=development

# Opt in to returning SSIDs and BSSIDs from the map API. Keep false unless
# every person who can reach the service is allowed to see them.
EXPOSE_NETWORK_IDENTIFIERS=false

# Optional live badge supplied by WiGLE. Leave blank to hide the badge.
WIGLE_BADGE_URL=
WIGLE_PROFILE_URL=https://wigle.net

# Optional automatic account-history sync. Create API credentials at
# https://wigle.net/account. Leave both credential values blank to disable.
WIGLE_API_NAME=
WIGLE_API_TOKEN=
WIGLE_SYNC_SECONDS=86400
WIGLE_SYNC_ON_START=true

RESCAN_SECONDS=0
MAX_UPLOAD_BYTES=4294967296
CPUS=4.0
MEM_LIMIT=8g
